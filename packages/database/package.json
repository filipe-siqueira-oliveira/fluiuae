{
  "name": "@fluiuae/database",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "prisma generate --schema prisma/schema.prisma",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma",
    "deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema prisma/schema.prisma",
    "push": "dotenv -e ../../.env -- prisma db push --schema prisma/schema.prisma",
    "studio": "dotenv -e ../../.env -- prisma studio --schema prisma/schema.prisma",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "prisma": "^6.3.1",
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.19.2"
  },
  "exports": {
    ".": "./src/index.ts",
    "./enums": "./src/domain_enums.ts"
  },
  "typesVersions": {
    "*": {
      "enums": [
        "src/domain_enums.ts"
      ]
    }
  }
}
